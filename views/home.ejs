<body>
    <div>

        <h1 class="title">Evalops Dashboard</h1>

        <div class="kpi-cards">
            <% Object.entries(data.data.overall_summary.kpi_cards).forEach(([key, value])=> { %>

                <div class="kpi-container">

                    <div class="card-header">
                        <div class="kpi-key">
                            <%= key.replaceAll("_", " " ) %>
                        </div>

                        <div class="icon">
                            📊
                        </div>
                    </div>

                    <div class="kpi-value">
                        <%= value %>
                    </div>

                </div>

                <% }) %>
        </div>




    </div>
</body>

